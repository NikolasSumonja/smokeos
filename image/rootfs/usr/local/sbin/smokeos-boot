#!/bin/bash
# Runs at every boot before the agent. First-boot-only steps are guarded by a flag file.
set -u
log() { echo "[smokeos-boot] $*"; }
get() { python3 /opt/smokeos/smokeos_rigconf.py get "$1"; }
STATE=/var/lib/smokeos
mkdir -p "$STATE"

# mount the SMOKEOS config partition (probed directly, no udev timing issues)
mkdir -p /smokeos-config
if ! mountpoint -q /smokeos-config; then
  for i in $(seq 1 30); do
    DEV=$(blkid -L SMOKEOS 2>/dev/null) && [ -n "$DEV" ] && break
    sleep 1
  done
  [ -n "${DEV:-}" ] && mount -t vfat -o umask=0077 "$DEV" /smokeos-config && log "config partition mounted ($DEV)"
fi

if [ ! -f /smokeos-config/rig.conf ]; then
  log "WARNING: /smokeos-config/rig.conf not found (is the SMOKEOS partition there?)"
fi

# ---------------------------------------------------------------- first boot only
if [ ! -f "$STATE/firstboot.done" ]; then
  log "first boot"
  # 1. grow the root partition to fill the whole USB / SSD
  ROOTDEV=$(findmnt -no SOURCE /)
  PKNAME=$(lsblk -no PKNAME "$ROOTDEV" | head -1)
  PARTNUM=$(cat "/sys/class/block/$(basename "$ROOTDEV")/partition" 2>/dev/null || echo "")
  if [ -n "$PKNAME" ] && [ -n "$PARTNUM" ]; then
    growpart "/dev/$PKNAME" "$PARTNUM" && resize2fs "$ROOTDEV" && log "root partition grown"
  fi
  # 2. unique identity per rig (every USB starts as a copy of the same image)
  rm -f /etc/machine-id /var/lib/dbus/machine-id
  systemd-machine-id-setup >/dev/null
  rm -f /etc/ssh/ssh_host_*
  ssh-keygen -A >/dev/null 2>&1
  touch "$STATE/firstboot.done"
fi

# ---------------------------------------------------------------- every boot
NAME=$(python3 - <<'PY'
import sys; sys.path.insert(0, "/opt/smokeos")
import smokeos_rigconf as r
print(r.clean_name(r.parse().get("RIG_NAME")))
PY
)
if [ -n "$NAME" ] && [ "$(hostname)" != "$NAME" ]; then
  hostnamectl set-hostname "$NAME" 2>/dev/null || echo "$NAME" > /etc/hostname
  sed -i "/127.0.1.1/d" /etc/hosts; echo "127.0.1.1 $NAME" >> /etc/hosts
  log "hostname set to $NAME"
fi

PW=$(get ROOT_PASSWORD)
if [ -n "$PW" ]; then echo "root:$PW" | chpasswd; else passwd -l root >/dev/null 2>&1; fi

python3 /opt/smokeos/smokeos_rigconf.py apply

# NVIDIA: keep the driver loaded between miner restarts
command -v nvidia-smi >/dev/null && nvidia-smi -pm 1 >/dev/null 2>&1

# ---------------------------------------------------------------- Tailscale
KEY=$(get TAILSCALE_AUTHKEY)
# a rig added on the home network gets the Tailscale key from the dashboard
[ -z "$KEY" ] && KEY=$(python3 -c "import json;print(json.load(open('/etc/smokeos/agent.json')).get('tailscale_authkey',''))" 2>/dev/null)
TSNAME=$(echo "$NAME" | tr -c 'A-Za-z0-9-\n' '-')
if ! command -v tailscale >/dev/null; then
  log "installing Tailscale"
  for i in 1 2 3 4 5; do
    curl -fsSL https://tailscale.com/install.sh | sh && break
    sleep 15
  done
fi
if command -v tailscale >/dev/null; then
  systemctl enable --now tailscaled >/dev/null 2>&1
  if ! tailscale status >/dev/null 2>&1; then
    if [ -n "$KEY" ]; then
      for i in 1 2 3 4 5; do
        tailscale up --authkey="$KEY" --hostname="$TSNAME" --ssh && { log "joined Tailscale as $NAME"; break; }
        sleep 15
      done
    else
      log "no Tailscale key yet (fine at home: the dashboard hands one over when the rig is added)"
    fi
  fi
fi
exit 0
